# Kopiere diese Datei nach .env.local und passe sie NICHT mit echten Secrets an.
# LOCAL_MOCK ist der sichere Default. Siehe README "Drei Development-Modi".
#
# Fuer DEV_INTEGRATION koennen ENTRA_*/PLATFORM_TENANT_ID/DIRECTORY_TENANT_ID/
# NOTIFICATIONS_SHARED_MAILBOX automatisiert erzeugt werden:
#   scripts/setup-entra-app.ps1 -Apply -WriteEnvLocal   (legt App Registration + Graph
#     Permissions im verbundenen Entra-Tenant an und schreibt die Werte nach .env.local)
# Optionale Spiegelung nach Azure Key Vault (nur wenn ein Vault bereits deployt ist,
# siehe infra/modules/key-vault.bicep, deployKeyVault=true):
#   scripts/sync-keyvault.ps1 -VaultName <name> -Apply

B2B_MODE=LOCAL_MOCK

# Provider-Auswahl (mock | graph)
DIRECTORY_PROVIDER=mock
EMAIL_PROVIDER=mock
JOB_QUEUE_PROVIDER=local
# DATA_PROVIDER: "cosmos" ist der Default unter LOCAL_MOCK (Cosmos DB Emulator, siehe
# scripts/requirements.ps1 -InitCosmosEmulator) — erfordert einen laufenden Emulator.
# Explizit auf "local" setzen, um ohne Emulator gegen InMemory-Repositories zu arbeiten.
DATA_PROVIDER=cosmos

# Sicherheits-Flags — dürfen in LOCAL_MOCK niemals true sein
ALLOW_GRAPH_WRITES=false
ALLOW_GUEST_DELETE=false

# Plattform-/Directory-Tenant (nur für DEV_INTEGRATION relevant; hier bewusst leer)
PLATFORM_TENANT_ID=
DIRECTORY_TENANT_ID=

# Microsoft Graph / Entra App Registration (nur DEV_INTEGRATION, niemals committen)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=

# Shared Mailbox für Graph sendMail (nur DEV_INTEGRATION)
NOTIFICATIONS_SHARED_MAILBOX=

# API / Web
API_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:5301

# Wird von .vscode/launch.json ("Portal API", ueber envFile) gelesen, damit der VS-Code-
# Debug-Start denselben Port verwendet wie API_BASE_URL oben. Von scripts/requirements.ps1
# automatisch synchron zu API_BASE_URL gehalten — nicht manuell abweichend setzen.
ASPNETCORE_URLS=http://localhost:5000

# Lokaler Azure Cosmos DB Emulator (nur wenn spaeter ein Cosmos-Adapter statt InMemory-
# Repositories genutzt wird). Wird durch scripts/requirements.ps1 -InitCosmosEmulator
# automatisch befuellt (Well-Known-Emulator-Key, kein echtes Secret, siehe Microsoft-Doku
# "What is the Azure Cosmos DB emulator? > Authentication"). Ohne -InitCosmosEmulator
# bleiben die Werte leer.
COSMOS_EMULATOR_ENDPOINT=
COSMOS_EMULATOR_KEY=
COSMOS_DATABASE_ID=

# Lokaler Azure Storage Emulator (Azurite, npm-Paket) fuer Blob/Queue/Table-Zugriffe in der
# Entwicklung. Wird durch scripts/requirements.ps1 -InitStorageEmulator automatisch befuellt
# (Well-Known-Azurite-Account "devstoreaccount1", kein echtes Secret, siehe Microsoft-Doku
# "Connect to Azurite with SDKs and tools"). Ohne -InitStorageEmulator bleibt der Wert leer.
AZURE_STORAGE_CONNECTION_STRING=
