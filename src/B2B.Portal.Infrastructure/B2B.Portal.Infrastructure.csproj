    <ProjectReference Include="..\B2B.Portal.Application\B2B.Portal.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- Nur fuer DATA_PROVIDER=cosmos (opt-in, Default bleibt InMemory). Newtonsoft.Json
         wird trotz System.Text.Json-Serializer intern von Microsoft.Azure.Cosmos'
         DocumentClient zur Laufzeit benoetigt (nicht nur ein Build-Time-Check) - explizit
         referenziert statt nur den Build-Check zu umgehen. -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.46.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Graph wird bewusst NICHT eingebunden, solange kein Dev-Tenant für
      DEV_INTEGRATION vorbereitet ist (siehe "Keine unbekannten IDs erfinden").
      GraphSharedMailboxEmailProvider ist als Adapterschale vorbereitet und referenziert
      nur Konfigurationswerte; das tatsächliche SDK-Paket wird ergänzt, sobald ein
      Dev App Registration existiert (siehe docs/architecture/mvp-test-report.md).
    -->
  </ItemGroup>

