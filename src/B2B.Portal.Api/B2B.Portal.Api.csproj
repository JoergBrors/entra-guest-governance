<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>b2b-portal-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\B2B.Portal.Domain\B2B.Portal.Domain.csproj" />
    <ProjectReference Include="..\B2B.Portal.Application\B2B.Portal.Application.csproj" />
    <ProjectReference Include="..\B2B.Portal.Infrastructure\B2B.Portal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT-Bearer-Middleware fuer die Validierung der von B2B.Portal.Infrastructure
         ausgestellten Tokens (siehe Auth/IdentityProviderConfig.cs). Nur die Middleware
         lebt hier, die Token-Ausstellung selbst liegt in Infrastructure. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

</Project>
